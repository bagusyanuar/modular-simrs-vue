{
  "name": "@neurovi-hospital/sdk-sso",
  "version": "1.0.0",
  "description": "Headless SSO Client for Neurovi SIMRS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "sso",
    "oauth2",
    "pkce",
    "headless"
  ],
  "author": "Neurovi",
  "license": "MIT",
  "dependencies": {
    "@genossys-hospital/http-sdk": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vue-router": "^5.0.6"
  },
  "peerDependencies": {
    "vue": "^3.5.30",
    "vue-router": "^5.0.6"
  }
}
