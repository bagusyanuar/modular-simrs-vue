{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "paths": {
      "@genrs/core/simrs/*": ["./features/core/src/simrs/*"],
      "@genrs/core/utils/*": ["./features/core/src/utils/*"],
      "@genrs/core/finance/*": ["./features/core/src/finance/*"],
      "@genrs/core/*": ["./features/core/src/*"],
      "@genrs/infrastructure/simrs/*": ["./features/infrastructure/src/simrs/*"],
      "@genrs/infrastructure/finance/*": ["./features/infrastructure/src/finance/*"],
      "@genrs/infrastructure/*": ["./features/infrastructure/src/*"],
      "@genrs/presentation": ["./features/presentation/src/index.ts"],
      "@genrs/presentation/*": ["./features/presentation/src/*"],
      "@genrs/auth": ["./packages/auth/src/index.ts"],
      "@genrs/auth/*": ["./packages/auth/src/*"],
      "@genrs/sso": ["./packages/sso/src/index.ts"],
      "@genrs/sso/*": ["./packages/sso/src/*"],
      "@genrs/ui": ["./packages/ui/src/index.ts"],
      "@genrs/ui/*": ["./packages/ui/src/*"],
      "@genossys-hospital/http-sdk": ["./packages/http-sdk/src/index.ts"],
      "@genossys-hospital/http-sdk/*": ["./packages/http-sdk/src/*"],
      "@genossys-hospital/sdk-sso": ["./packages/sdk-sso/src/index.ts"],
      "@genossys-hospital/sdk-sso/*": ["./packages/sdk-sso/src/*"],
      "@page/*": [
        "./features/presentation/src/simrs/base/*"
      ]
    }
  }
}
