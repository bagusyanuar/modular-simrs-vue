{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@genossys-hospital/presentation/*": ["../../modules/presentation/src/*"],
      "@genossys-hospital/sdk-sso": ["../../packages/sdk-sso/src/index.ts"],
      "@genossys-hospital/sdk-sso/*": ["../../packages/sdk-sso/src/*"],
      "@genossys-hospital/http-sdk": ["../../packages/http-sdk/src/index.ts"],
      "@genossys-hospital/http-sdk/*": ["../../packages/http-sdk/src/*"],
      "@genrs/ui": ["../../packages/ui/src/index.ts"],
      "@genrs/ui/*": ["../../packages/ui/src/*"]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
